# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
# Option A: single connection string (recommended for Railway)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/bravehearts
# Set to disable for local PostgreSQL without SSL. Railway can omit this or leave it enabled.
PGSSLMODE=disable

# Option B: separate connection fields, used only when DATABASE_URL is not set
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bravehearts
# DB_USER=postgres
# DB_PASSWORD=your_password

# Session Configuration
SESSION_SECRET=your_session_secret_change_this_in_production
SESSION_MAX_AGE=86400000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Redis Configuration (optional - for caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# FIBA GDAP API Configuration
# Register/subscribe at https://gdap-portal.fiba.basketball/ and set your subscription key here.
FIBA_API_BASE_URL=https://api.fiba.basketball
FIBA_API_KEY=
FIBA_API_TIMEOUT_MS=10000

# Google Sign-In (OAuth) for user registration/login
# Create an OAuth 2.0 Web Client in Google Cloud Console and add http://localhost:3000 to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# Email Configuration (Gmail/Outlook SMTP: password reset, welcome, order, payment emails)
# PUBLIC_APP_URL=http://localhost:3000
# Gmail example: use a Google App Password, not your normal Gmail password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_google_app_password
# Outlook/Microsoft 365 example:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@outlook.com
# SMTP_PASSWORD=your_outlook_password_or_app_password
# EMAIL_FROM=Bravehearts Basketball Club <your_email@gmail.com>
