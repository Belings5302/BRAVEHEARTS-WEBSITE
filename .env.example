# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
# Option A: single connection string (recommended for Railway)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/bravehearts
# Set to disable for local PostgreSQL without SSL. Railway can omit this or leave it enabled.
PGSSLMODE=disable

# Option B: separate connection fields, used only when DATABASE_URL is not set
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bravehearts
# DB_USER=postgres
# DB_PASSWORD=your_password

# Session Configuration
SESSION_SECRET=your_session_secret_change_this_in_production
SESSION_MAX_AGE=86400000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Redis Configuration (optional - for caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# FIBA GDAP API Configuration
# Register/subscribe at https://gdap-portal.fiba.basketball/ and set your subscription key here.
FIBA_API_BASE_URL=https://api.fiba.basketball
FIBA_API_KEY=
FIBA_API_TIMEOUT_MS=10000

# Email Configuration (for password reset)
# PUBLIC_APP_URL=http://localhost:3000
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=Bravehearts Basketball Club <noreply@bravehearts.com>
