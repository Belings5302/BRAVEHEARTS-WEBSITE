{
  "name": "bravehearts-basketball-backend",
  "version": "1.0.0",
  "description": "Backend API and database support for Bravehearts Basketball Club",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "vite build",
    "test": "vitest",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "backup": "node scripts/backup-database.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.11.3",
    "redis": "^4.6.0",
    "sharp": "^0.33.0",
    "winston": "^3.11.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@vitejs/plugin-legacy": "^5.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "typescript": "^5.3.3",
